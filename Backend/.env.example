# Sample environment variables for LuxStay Hotel backend

# Server settings
PORT=3007             # port the Node server listens on
HOST=http://localhost # optional base host, used when constructing BASE_URL
BASE_URL=http://localhost:3007 # full base URL (host + port). Override in production (e.g. https://yourdomain.com)

# Database
# For production (Neon/Postgres), set DATABASE_URL to your Neon connection string.
# If DATABASE_URL is not set, the app falls back to SQLite for local development.
DATABASE_URL=postgres://username:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require

# SSL Commerz configuration
# Leave as-is to use SSL Commerz's public sandbox demo store (testbox/qwerty),
# or replace with your own sandbox/live credentials from developer.sslcommerz.com
SSL_STORE_ID=testbox
SSL_STORE_PASSWORD=qwerty
SSL_IS_SANDBOX=true   # set false for production

# Any other secrets should be defined here
